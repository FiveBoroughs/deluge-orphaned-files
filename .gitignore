# Ignore .env file containing sensitive information
.env

# Ignore Python bytecode files
__pycache__/
*.py[cod]

# Ignore virtual environment directories
venv/
env/
.venv/

# Ignore log files
*.log
config/logs/

# Ignore output files
orphaned_files.json
config/*.json
config/*.txt
config/*.db
deluge_orphaned_files.db
.devdbrc
comparison_results.txt
emails/

# Ignore system-specific files
.DS_Store
Thumbs.db

# Ignore IDE-specific files
.vscode/
.idea/

# Ignore local temp artifacts
.tmp/

# Ignore local agent/tool state
.claude/
.scratch/

# Local-only ops material (LAN details / credentials; never commit)
HANDOFF-*.md
get_paused_torrents.py

# Generated report files
DelugeOrphanedFilesReport*.md
